	(text "R3 is the pullup resistor since the LM339 is an open collector.\nR4 is the gate resistor to limit the inrush current that charges the gate-source capacitance.\nR5 is the pulldown resistor for the MOSFET to discharge the gate-source capacitance when switched off.\n"
		(exclude_from_sim no)
		(at 144.018 72.136 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "1e759dde-e645-4e0a-8730-e45cce1a0fa8")
	)
	(text "D1 is the IR LED."
		(exclude_from_sim no)
		(at 31.242 33.528 0)
		(effects
			(font
				(size 1.016 1.016)
				(thickness 0.127)
			)
			(justify left)
		)
		(uuid "272f6d34-284a-449a-959f-5b77d10c12c8")
	)
	(text "D2 is the IR photodiode.\nIt is what senses the reflected light from D1."
		(exclude_from_sim no)
		(at 70.358 35.814 0)
		(effects
			(font
				(size 1.016 1.016)
				(thickness 0.127)
			)
			(justify left)
		)
		(uuid "2f1e901b-622a-450d-930d-955ce3fd9000")
	)
	(text "R1 is the current-limiting\nresistor for D1."
		(exclude_from_sim no)
		(at 22.86 47.752 0)
		(effects
			(font
				(size 1.016 1.016)
				(thickness 0.127)
			)
			(justify left)
		)
		(uuid "5c8ddbd9-d4be-4c26-b535-cf26ebadd3e7")
	)
	(text "RV1 is the potentiometer\nused to set a reference voltage\nfor the comparator."
		(exclude_from_sim no)
		(at 85.598 73.406 0)
		(effects
			(font
				(size 1.016 1.016)
				(thickness 0.127)
			)
			(justify left)
		)
		(uuid "6110d6c5-344c-4baf-96aa-b8f3961b0c96")
	)
	(text "Power section."
		(exclude_from_sim no)
		(at 228.346 98.806 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify left)
		)
		(uuid "71cc783f-6fd1-4839-b8b0-04e32a73acf0")
	)
	(text "D3 is the flyback diode that catches the inductive kickback when the motor is turned off.\nC1 is a decoupling capacitor to prevent the electrical noise of the motors going back to the circuit.\nC2 is a bulk capacitor for transient energy supply boosts.\n"
		(exclude_from_sim no)
		(at 151.638 28.194 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "80627806-6498-41ae-8668-40cc06551d80")
	)
	(text "Unused opamps with inputs shorted\nto prevent floating."
		(exclude_from_sim no)
		(at 196.596 113.03 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "aa0ff2a2-24d2-4cb4-a9ad-47dca719188a")
	)
	(text "The voltage drop accross R2\nis the output from the IR photodiode."
		(exclude_from_sim no)
		(at 64.262 52.324 0)
		(effects
			(font
				(size 1.016 1.016)
				(thickness 0.127)
			)
			(justify left)
		)
		(uuid "cad69fd2-e17a-488a-a7ab-99d57f06d63e")
	)
	(text "C5 is the decoupling capacitor\nfor the supply voltage\nof the IC to prevent \nelectrical noise from affecting the comparator."
		(exclude_from_sim no)
		(at 236.982 155.702 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "d55e31c8-f8be-499b-8ff6-9544980aef0a")
	)
	(text "Equivalent electronics for the right side."
		(exclude_from_sim no)
		(at 39.116 121.412 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "f40bd493-ed6a-4a08-ac47-a198009fad8d")
	)
